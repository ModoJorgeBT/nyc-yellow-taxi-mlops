# Plantilla publica sin secretos. T02 no carga estas variables automaticamente.
# Las rutas son relativas a la raiz del proyecto.
DATA_DIR=./data
REPORTS_DIR=./reports

# T18: servidor local con entorno aislado y SQLite/artefactos persistentes.
# Compose y la direccion entre contenedores se verificaran en T24.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_DISABLE_TELEMETRY=true

# T24: Compose usa una copia aislada; el MLflow nativo conserva 5000.
COMPOSE_STATE_DIR=./.cache/compose-state
DOCKER_MLFLOW_PORT=5001
DOCKER_API_PORT=8080
DOCKER_UNAVAILABLE_PORT=8001
# El transporte interno lo fija Compose. No cambia configs/champion.yaml.
